# ===================================================================
# General .gitignore file
#
# For more specific templates, you can visit:
# https://github.com/github/gitignore
# ===================================================================

# =========================================
# Operating System Files
# =========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*
Thumbs.db

# Windows
ehthumbs.db
Desktop.ini

# =========================================
# IDEs and Editors
# =========================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iml

# Eclipse
.project
.classpath
.settings/

# =========================================
# Dependencies / Packages
# =========================================
/node_modules/
/bower_components/
/vendor/
/jspm_packages/

# =========================================
# Build output & Compiled files
# =========================================
/build/
/dist/
/out/
/target/
/bin/
*.o
*.obj
*.class
*.pyc
*.pyo
*.so

# =========================================
# Log files
# =========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# =========================================
# Runtime data
# =========================================
pids/
*.pid
*.seed
*.pid.lock

# =========================================
# Environment variables
# =========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# To keep an example env file, uncomment the line below
# !.env.example

# =========================================
# Temporary files
# =========================================
*~
*.tmp
*.swp
*.swo

# =========================================
# Coverage reports
# =========================================
/coverage/
/.nyc_output/

# =========================================
# Compressed files
# =========================================
*.zip
*.tar.*
*.rar
